{
    "applicationId": "com.geyize.longpaopao",
    "version": "1.0.0",
    "defaultMode": "window",
    "port": 0,
    "documentRoot": "/",
    "url": "/index.html",
    "enableServer": true,
    "enableNativeAPI": false,
    "tokenSecurity": "none",
    "logging": {
        "enabled": true,
        "writeToLogFile": false
    },
    "nativeAllowList": [],
    "globalVariables": {},
    "modes": {
        "window": {
            "title": "龙泡泡大作战",
            "width": 540,
            "height": 800,
            "minWidth": 540,
            "minHeight": 800,
            "maxWidth": 540,
            "maxHeight": 800,
            "fullScreen": false,
            "alwaysOnTop": false,
            "icon": "/js/assests/red.png",
            "enableInspector": false,
            "borderless": false,
            "maximize": false,
            "hidden": false,
            "resizable": false,
            "exitProcessOnClose": true,
            "webviewArgs": ""
        }
    },
    "cli": {
        "binaryName": "longpaopao",
        "resourcesPath": "/resources/",
        "extensionsPath": "/extensions/",
        "clientLibrary": "/resources/js/neutralino.js",
        "binaryVersion": "5.4.0",
        "clientVersion": "3.12.0"
    }
}